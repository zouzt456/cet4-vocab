{
  "name": "cet4-vocab",
  "productName": "四级词汇",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "四级词汇 · 离线背单词卡片（Vue 3 + Vite + Electron + Android WebView）",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "electron:start": "electron electron/main.cjs",
    "dist:exe": "electron-builder --win portable --config electron-builder.yml --publish never",
    "apk": "bash android/build.sh"
  },
  "dependencies": {
    "vue": "^3.5.44",
    "pinia": "^4.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  },
  "main": "electron/main.cjs",
  "author": "zouzt456"
}
