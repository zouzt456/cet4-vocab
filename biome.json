{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": {
    "includes": [
      "src/**",
      "tests/**",
      "*.ts",
      "*.json",
      "!.vite",
      "!dist",
      "!release",
      "!build",
      "!data",
      "!android",
      "!node_modules",
      "!pnpm-lock.yaml",
      "!src/template.html",
      "!src/template.html"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "linter": { "enabled": true, "rules": { "recommended": true } },
  "assist": { "enabled": false }
}
